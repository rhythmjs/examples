{
  "name": "rhythmjs-examples",
  "version": "0.0.1",
  "private": true,
  "description": "Examples for Rhythm on Bun: databases (Drizzle, Prisma, MikroORM, MongoDB) and integrations (AI SDK, Better Auth, Nodemailer, Redis, Resend, file upload, Scalar, Swagger UI, BullMQ).",
  "homepage": "https://rhythm.js.org",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/examples.git"
  },
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "oxlint examples/*/src examples/*/test",
    "fmt": "prettier --write \"examples/*/src/**/*.ts\" \"examples/*/test/**/*.ts\" \"examples/*/*.ts\" \"examples/*/*.json\" \"*.json\"",
    "fmt:check": "prettier --check \"examples/*/src/**/*.ts\" \"examples/*/test/**/*.ts\" \"examples/*/*.ts\" \"examples/*/*.json\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma"
  ],
  "overrides": {
    "@rhythmjs/http": "file:../http",
    "@rhythmjs/openapi": "file:../openapi/packages/openapi",
    "@rhythmjs/rhythm": "file:../rhythm/packages/rhythm",
    "@rhythmjs/router": "file:../rhythm/packages/router",
    "@rhythmjs/scalar": "file:../openapi/packages/scalar",
    "@rhythmjs/swagger": "file:../openapi/packages/swagger"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
